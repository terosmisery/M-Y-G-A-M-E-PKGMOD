blackScreen.Position =
	UDim2.fromScale(0, 0)

blackScreen.ZIndex = 10000

blackScreen.Visible = true

blackScreen.Parent = baseFrame

--==================================================
-- ZOOM
--==================================================

local zoomScale =
	baseFrame:FindFirstChild(
		"C9HZZTransitionScale"
	)

local createdScale = false

if not zoomScale then

	zoomScale = Instance.new("UIScale")

	zoomScale.Name =
		"C9HZZTransitionScale"

	zoomScale.Scale = 1

	zoomScale.Parent = baseFrame

	createdScale = true
end

local originalScale =
	zoomScale.Scale

--==================================================
-- ZOOM IN + BLACK
--==================================================

local zoomIn =
	TweenService:Create(

		zoomScale,

		TweenInfo.new(
			2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In
		),

		{
			Scale = originalScale * 1.12
		}
	)

local blackIn =
	TweenService:Create(

		blackScreen,

		TweenInfo.new(
			2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In
		),

		{
			BackgroundTransparency = 0
		}
	)

zoomIn:Play()
blackIn:Play()

zoomIn.Completed:Wait()

blackScreen.BackgroundTransparency = 0

--==================================================
-- EVERYTHING BELOW HAPPENS WHILE BLACK
--==================================================

