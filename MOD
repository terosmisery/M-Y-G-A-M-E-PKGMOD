	zoomScale = Instance.new("UIScale")

	zoomScale.Name =
		"C9HZZTransitionScale"

	zoomScale.Scale = 1

	zoomScale.Parent =
		baseFrame

	createdScale = true
end

local originalScale =
	zoomScale.Scale

--==================================================
-- ZOOM IN
--==================================================

local zoomIn =
	TweenService:Create(

		zoomScale,

		TweenInfo.new(
			2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In
		),

		{
			Scale = originalScale * 1.12
		}
	)

zoomIn:Play()

--==================================================
-- FADE TO BLACK
--==================================================

local blackTween =
	TweenService:Create(

		blackScreen,

		TweenInfo.new(
			2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In
		),

		{
			BackgroundTransparency = 0
		}
	)

blackTween:Play()

zoomIn.Completed:Wait()

