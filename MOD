	vignetteLabel.TextTransparency = 0
end

for _, obj in ipairs(
	vignetteLabel:GetDescendants()
) do

	if obj:IsA("GuiObject") then
		obj.Visible = true
		obj.BackgroundTransparency = 1
	end

	if obj:IsA("ImageLabel")
		or obj:IsA("ImageButton") then

		obj.ImageTransparency = 0
	end

	if obj:IsA("TextLabel")
		or obj:IsA("TextButton") then

		obj.TextTransparency = 0
	end
end

--==================================================
-- KEEP VIGNETTE ENABLED FOREVER
--==================================================

local permanentVignetteLock

permanentVignetteLock =
	RunService.Heartbeat:Connect(function()

		if not vignetteLabel
			or not vignetteLabel.Parent then
			return
		end

		vignetteLabel.Visible = true

		-- Background MUST remain transparent.
		vignetteLabel.BackgroundTransparency = 1

		for _, obj in ipairs(
			vignetteLabel:GetDescendants()
		) do

			if obj:IsA("GuiObject") then
				obj.Visible = true
				obj.BackgroundTransparency = 1
			end

			if obj:IsA("ImageLabel")
				or obj:IsA("ImageButton") then

				obj.ImageTransparency = 0
			end

			if obj:IsA("TextLabel")
				or obj:IsA("TextButton") then

				obj.TextTransparency = 0
			end
		end

	end)

--==================================================
-- HOLD BLACK
--==================================================

task.wait(1.5)

