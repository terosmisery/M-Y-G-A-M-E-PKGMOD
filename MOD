--==================================================
-- INPUT LOCK
--==================================================

local interactionLocked = true

local lockedButtons = {}
local lockedTextBoxes = {}

local function enforceGuiLock()

	for _, obj in ipairs(mainUI:GetDescendants()) do

		if obj:IsA("GuiButton") then

			if not lockedButtons[obj] then
				lockedButtons[obj] = {
					Active = obj.Active,
					Selectable = obj.Selectable,
					AutoButtonColor = obj.AutoButtonColor
				}
			end

			obj.Active = false
			obj.Selectable = false
			obj.AutoButtonColor = false

		elseif obj:IsA("TextBox") then

			if not lockedTextBoxes[obj] then
				lockedTextBoxes[obj] = {
					Active = obj.Active,
					TextEditable = obj.TextEditable
				}
			end

			obj.Active = false
			obj.TextEditable = false
		end
	end
end

local function restoreGui()

	for obj, state in pairs(lockedButtons) do

		if obj and obj.Parent then
			obj.Active = state.Active
			obj.Selectable = state.Selectable
			obj.AutoButtonColor = state.AutoButtonColor
		end
	end

	for obj, state in pairs(lockedTextBoxes) do

		if obj and obj.Parent then
			obj.Active = state.Active
			obj.TextEditable = state.TextEditable
		end
	end

	table.clear(lockedButtons)
	table.clear(lockedTextBoxes)
end

enforceGuiLock()

local guiLockConnection =
	RunService.Heartbeat:Connect(function()

		if interactionLocked then
			enforceGuiLock()
		end

	end)

