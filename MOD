--==================================================
-- TRANSITION BLACK SCREEN
--==================================================

local blackScreen =
	Instance.new("Frame")

blackScreen.Name =
	"C9HZZTransition"

blackScreen.BackgroundColor3 =
	Color3.new(0, 0, 0)

blackScreen.BackgroundTransparency = 1

blackScreen.BorderSizePixel = 0

blackScreen.Size =
